#include <dt-bindings/zmk/mouse.h>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors/num_word.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define U_TAPPING_TERM 200

/ {
    trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;
        input-processors = <&zip_xy_scaler 1 2>, <&zip_temp_layer 4 400>;

        // Switch to auto-mouse temp layer, decrease sensitivity

        scroll {
            layers = <1>; // SCROLL
            input-processors =
                <&zip_xy_scaler 1 20>,
                <&zip_xy_to_scroll_mapper>,
                <&zip_scroll_transform (INPUT_TRANSFORM_Y_INVERT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        greater_than {
            bindings = <&kp GREATER_THAN>;
            key-positions = <6 18>;
            timeout-ms = <70>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        less_than {
            bindings = <&kp LESS_THAN>;
            key-positions = <18 30>;
            timeout-ms = <70>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        right_parenthesis {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <7 19>;
            timeout-ms = <70>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        left_parenthesis {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <19 31>;
            timeout-ms = <70>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        right_brace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <8 20>;
            timeout-ms = <70>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        left_brace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <20 32>;
            timeout-ms = <70>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        right_bracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <9 21>;
            timeout-ms = <70>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        left_bracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <21 33>;
            timeout-ms = <70>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        left_click {
            bindings = <&mkp LCLK>;
            key-positions = <4 16>;
            timeout-ms = <70>;
            require-prior-idle-ms = <50>;
            layers = <0 4>;
        };

        right_click {
            bindings = <&mkp RCLK>;
            key-positions = <16 28>;
            timeout-ms = <70>;
            require-prior-idle-ms = <50>;
            layers = <0 4>;
        };

        double_quotes {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <3 15>;
            timeout-ms = <70>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        single_quote {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <15 27>;
            timeout-ms = <70>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        slash {
            bindings = <&kp SLASH>;
            key-positions = <2 14>;
            timeout-ms = <70>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        backslash {
            bindings = <&kp BACKSLASH>;
            key-positions = <14 26>;
            timeout-ms = <70>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <13 25>;
            timeout-ms = <70>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        underscore {
            bindings = <&kp UNDERSCORE>;
            key-positions = <1 13>;
            timeout-ms = <70>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };
    };

    behaviors {
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <39 40 30 31 19 18 6 7 8 9 10 11 20 21 22 23 32 33 34 35>;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <38 37 36 29 28 27 26 25 24 12 13 14 15 17 16 5 4 3 2 1 0>;
        };

        coma_semicolon: coma_semicolon {
            compatible = "zmk,behavior-mod-morph";
            label = "COMA_SEMICOLON";
            bindings = <&kp COMMA>, <&kp SEMICOLON>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        dot_colon: dot_colon {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_COLON";
            bindings = <&kp DOT>, <&kp COLON>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        qmark_exclemation: qmark_exclemation {
            compatible = "zmk,behavior-mod-morph";
            label = "QMARK_EXCLEMATION";
            bindings = <&kp QUESTION>, <&kp EXCLAMATION>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        magic_shift: magic_shift {
            compatible = "zmk,behavior-mod-morph";
            label = "MAGIC_SHIFT";
            bindings = <&sk LSHFT>, <&caps_word>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        num_dance: num_dance {
            compatible = "zmk,behavior-tap-dance";
            label = "NUM_DANCE";
            #binding-cells = <0>;
            bindings = <&num_word 1>, <&sl 1>;
        };

        smart_num: smart_num {
            compatible = "zmk,behavior-hold-tap";
            label = "SMART_NUM";
            bindings = <&mo>, <&num_dance>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&trans     &kp J               &kp C         &kp Y           &kp F             &kp K          &kp Z            &kp L             &coma_semicolon  &kp U               &kp Q        &trans
&kp ENTER  &hml LGUI R         &hml LSHFT S  &hml LCTRL T    &hml RIGHT_ALT H  &kp D          &kp M            &hmr RIGHT_ALT N  &hmr RCTRL A     &hmr RIGHT_SHIFT I  &hmr LGUI O  &kp ESCAPE
&kp TAB    &qmark_exclemation  &kp V         &kp G           &kp P             &kp B          &kp X            &kp W             &dot_colon       &kp EQUAL           &kp GRAVE    &trans
                                             &smart_num 1 0  &lt 3 E           &lt 1 SPACE    &lt 2 BACKSPACE  &magic_shift
            >;
        };

        numbers {
            bindings = <
&trans  &trans        &trans        &trans        &trans        &trans          &trans        &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5    &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0  &trans
&trans  &trans        &trans        &trans        &trans        &trans          &trans        &trans        &trans        &trans        &trans        &trans
                                    &trans        &trans        &trans          &trans        &trans
            >;
        };

        symbols {
            bindings = <
&trans  &trans     &trans       &trans    &trans      &trans         &trans     &trans         &trans        &trans    &trans     &trans
&trans  &kp TILDE  &kp AT_SIGN  &kp HASH  &kp DOLLAR  &kp PERCENT    &kp CARET  &kp AMPERSAND  &kp ASTERISK  &kp PIPE  &kp GRAVE  &trans
&trans  &trans     &trans       &trans    &trans      &trans         &trans     &trans         &trans        &trans    &trans     &trans
                                &trans    &trans      &trans         &trans     &trans
            >;
        };

        navigation {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans          &trans          &trans        &trans           &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans          &trans          &trans        &trans           &trans  &trans
                        &trans  &trans  &trans    &trans          &trans
            >;
        };

        auto_mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
            >;
        };
    };
};
